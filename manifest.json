{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/main/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "com.dnl.dbx-chart-board",
  "name": "ChatBoard",
  "version": "0.1.0",
  "publisher": "dnl",
  "description": "AI-friendly dashboard: turn query results into charts by talking to an agent via MCP tools.",
  "icon": "assets/plugin.svg",
  "permissions": ["host.data:read", "host.storage"],
  "engines": {
    "dbx": ">=0.5.68",
    "host_api": "1"
  },
  "entrypoints": {
    "backend": {
      "executable": "bin/windows-x64/dbx-chart-board-backend.exe"
    },
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    }
  },
  "contributions": [
    {
      "type": "workbench",
      "id": "com.dnl.dbx-chart-board.workbench",
      "label": "ChatBoard",
      "description": "Talk to create a persistent chart board from query results.",
      "icon": "assets/plugin.svg"
    },
    {
      "type": "context-menu",
      "id": "com.dnl.dbx-chart-board.open",
      "label": "Open ChatBoard",
      "menu": "connection",
      "action": {
        "type": "open-workbench",
        "workbench": "com.dnl.dbx-chart-board.workbench"
      }
    },
    {
      "type": "mcp",
      "id": "com.dnl.dbx-chart-board.mcp",
      "description": "Agent tools for adding and managing chart-board cards from a conversation.",
      "external_tools": true,
      "toolsets": [
        { "id": "chart-board", "title": "对话图表看板" }
      ],
      "tools": {
        "list_boards": { "access": "read", "toolset": "chart-board" },
        "add_card": { "access": "write", "toolset": "chart-board" },
        "remove_card": { "access": "write", "toolset": "chart-board" }
      }
    }
  ],
  "localizations": {
    "zh-CN": {
      "name": "对话图表看板",
      "description": "用对话直接生成图表的看板：Agent 通过 MCP 一句话把查询结果变成可保存的数据卡片。",
      "contributions": {
        "com.dnl.dbx-chart-board.workbench": {
          "label": "对话图表看板",
          "description": "对 Agent 说一句话，把查询结果变成可保存的图表面板。"
        },
        "com.dnl.dbx-chart-board.open": {
          "label": "打开对话图表看板"
        },
        "com.dnl.dbx-chart-board.mcp": {
          "label": "对话图表看板工具"
        }
      }
    }
  }
}
