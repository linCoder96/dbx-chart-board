{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/main/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "com.dnl.dbx-chart-board",
  "name": "Chart Board",
  "version": "0.1.0",
  "publisher": "dnl",
  "description": "AI-friendly dashboard board: zero-config charts for query results.",
  "icon": "assets/plugin.svg",
  "permissions": ["host.data:read", "host.storage"],
  "engines": {
    "dbx": ">=0.5.68",
    "host_api": "1"
  },
  "entrypoints": {
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    }
  },
  "contributions": [
    {
      "type": "workbench",
      "id": "com.dnl.dbx-chart-board.workbench",
      "label": "Chart Board",
      "description": "Dashboard board for query results.",
      "icon": "assets/plugin.svg"
    },
    {
      "type": "context-menu",
      "id": "com.dnl.dbx-chart-board.open",
      "label": "Open Chart Board",
      "menu": "connection",
      "action": {
        "type": "open-workbench",
        "workbench": "com.dnl.dbx-chart-board.workbench"
      }
    }
  ],
  "localizations": {
    "zh-CN": {
      "name": "图表看板",
      "description": "面向查询结果的免配置 AI 图表看板。",
      "contributions": {
        "com.dnl.dbx-chart-board.workbench": {
          "label": "图表看板",
          "description": "把查询结果一键变成可保存的图表面板。"
        },
        "com.dnl.dbx-chart-board.open": {
          "label": "打开图表看板"
        }
      }
    }
  }
}
